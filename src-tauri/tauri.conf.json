{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inari",
  "version": "1.0.5",
  "identifier": "com.fbnlrz.inari",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Inari",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "/usr/share/icons/**",
          "/usr/share/pixmaps/**",
          "/var/lib/flatpak/exports/share/icons/**",
          "$HOME/.local/share/icons/**",
          "$HOME/.local/share/flatpak/exports/share/icons/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libayatana-appindicator3-1",
          "pulseaudio-utils",
          "pipewire-pulse",
          "wireplumber"
        ],
        "files": {
          "/usr/lib/udev/rules.d/60-inari.rules": "../packaging/udev/60-inari.rules"
        },
        "postInstallScript": "../packaging/deb/postinst",
        "postRemoveScript": "../packaging/deb/postrm"
      },
      "rpm": {
        "depends": [
          "libayatana-appindicator3.so.1()(64bit)",
          "pulseaudio-utils",
          "pipewire-pulseaudio",
          "wireplumber"
        ],
        "files": {
          "/usr/lib/udev/rules.d/60-inari.rules": "../packaging/udev/60-inari.rules"
        },
        "postInstallScript": "../packaging/deb/postinst"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
